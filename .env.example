PORT=5000
JWT_SECRET=change-this-to-a-long-random-secret
ADMIN_SIGNUP_CODE=make-me-admin

# Add this on Railway after attaching PostgreSQL.
# DATABASE_URL=postgresql://user:password@host:port/database

# Optional: set true to create demo users/projects/tasks on an empty database.
SEED_DEMO=true

# Optional when frontend and API are on different origins in development.
CLIENT_URL=http://localhost:5173
